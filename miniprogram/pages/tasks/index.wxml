<view class="page"><view class="section-title">救助任务</view><view wx:if="{{loading}}" class="state loading">正在加载任务…</view><view wx:elif="{{error}}" class="state error">{{error}}</view><view wx:elif="{{empty}}" class="state empty">暂时没有开放任务</view><view wx:else class="list"><view class="row" wx:for="{{items}}" wx:key="id"><view class="card-title">{{item.title}}</view><view class="meta">{{item.description}}</view><button wx:if="{{item.status==='OPEN'}}" class="button" size="mini" data-id="{{item.id}}" bindtap="claim">领取任务</button></view></view></view>
