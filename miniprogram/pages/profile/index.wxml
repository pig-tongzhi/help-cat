<view class="page"><view class="section-title">我的</view><view class="account"><view wx:if="{{loading}}" class="state loading">正在登录…</view><view wx:elif="{{error}}" class="state error">{{error}}</view><block wx:elif="{{user}}"><view class="card-title">已登录</view><view class="meta">身份：{{user.role}}</view><button class="button secondary" bindtap="logout">退出登录</button></block><block wx:else><view class="empty">登录后可领取任务并查看自己的提交</view><button class="button" bindtap="login">微信一键登录</button></block></view><view class="state">安得广厦千万间，大庇天下小猫俱欢颜</view></view>
