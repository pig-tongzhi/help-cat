<view class="page"><view class="section-title">猫咪档案</view><view wx:if="{{loading}}" class="state loading">正在加载档案…</view><view wx:elif="{{error}}" class="state error">{{error}}</view><view wx:elif="{{empty}}" class="state empty">还没有公开档案</view><view wx:else class="grid"><view class="card" wx:for="{{items}}" wx:key="id"><image wx:if="{{!item.photo_failed && item.photo_url}}" class="card-image" mode="aspectFill" lazy-load="{{true}}" src="{{item.photo_url}}" data-index="{{index}}" data-collection="items" binderror="onPhotoError"/><view wx:else class="card-image card-image-placeholder">暂无照片</view><view class="card-body"><view class="card-title">{{item.nickname}}</view><view class="meta">{{item.community_name}} · {{item.health_status}}</view></view></view></view></view>
