<view class="page"><view class="photo" bindtap="choosePhoto"><image wx:if="{{photoPath}}" src="{{photoPath}}" mode="aspectFill" /><text wx:else>点击拍照或从相册选择</text></view><input placeholder="所属小区名称" value="{{form.communityName}}" data-key="communityName" bindinput="onInput" /><input placeholder="猫咪名称" value="{{form.nickname}}" data-key="nickname" bindinput="onInput" /><view class="location-row"><input placeholder="活动位置" value="{{form.location_note}}" data-key="location_note" bindinput="onInput" /><button size="mini" bindtap="getLocation">获取当前位置</button></view><text class="hint">无法授权定位时，可以手动填写小区内位置。</text><input placeholder="居住情况（可选）" value="{{form.living_status}}" data-key="living_status" bindinput="onInput" /><textarea placeholder="补充说明（可选）" value="{{form.notes}}" data-key="notes" bindinput="onInput" /><button class="primary" bindtap="submit">提交审核</button></view>
