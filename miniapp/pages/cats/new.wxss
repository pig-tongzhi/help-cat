.page{min-height:100vh;background:#f7f8f5;padding:36rpx 30rpx;color:#18231f}.photo{height:420rpx;border:2rpx dashed #eb7356;border-radius:28rpx;background:#fff1e5;color:#704a39;display:flex;align-items:center;justify-content:center;margin-bottom:24rpx}.photo image{width:100%;height:100%;border-radius:26rpx}.page input,.page textarea{background:#fff;border:1rpx solid #e7ece8;border-radius:16rpx;padding:24rpx;margin:14rpx 0;width:auto}.page textarea{height:180rpx}.location-row{display:flex;align-items:center;gap:12rpx}.location-row input{flex:1}.location-row button{white-space:nowrap}.hint{display:block;color:#829088;font-size:22rpx}.primary{background:#eb7356;color:#fff;border-radius:18rpx;margin-top:22rpx}
