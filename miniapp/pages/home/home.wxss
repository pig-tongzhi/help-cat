.page{min-height:100vh;background:#f7f8f5;padding:44rpx 32rpx;color:#18231f}.topbar{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:34rpx}.eyebrow{display:block;font-size:20rpx;letter-spacing:3rpx;color:#7b8b82;font-weight:700}.title{display:block;font-size:50rpx;font-weight:800;letter-spacing:-2rpx;line-height:1.25;margin-top:22rpx}.accent{color:#eb7356}.paw{width:86rpx;height:86rpx;border-radius:30rpx;background:#eaf5ed;display:flex;align-items:center;justify-content:center;font-size:42rpx}.search{display:flex;align-items:center;gap:12rpx;background:#fff;border:1rpx solid #e6ebe6;border-radius:22rpx;padding:0 24rpx;color:#9aa69f;box-shadow:0 12rpx 30rpx #193c310a}.search input{flex:1;padding:26rpx 0;font-size:27rpx;background:transparent}.notice{display:flex;align-items:center;gap:18rpx;background:#fff2e9;border-radius:22rpx;padding:24rpx;margin-top:22rpx;color:#704a39}.notice>view{flex:1}.notice-icon{font-size:36rpx;color:#ef7657}.notice-title{display:block;font-size:28rpx;font-weight:700;margin-bottom:6rpx}.section-head{display:flex;justify-content:space-between;align-items:center;margin:42rpx 0 18rpx;font-weight:800;font-size:34rpx}.muted{color:#829088;font-size:23rpx;font-weight:400}.community,.cat-card{background:#fff;border:1rpx solid #e7ece8;border-radius:22rpx;padding:25rpx;margin-bottom:14rpx;box-shadow:0 8rpx 20rpx #193c3106}.community{display:flex;justify-content:space-between;align-items:center}.community-name{display:block;font-size:29rpx;font-weight:700;margin-bottom:7rpx}.count{color:#e76f51;font-size:23rpx}.cat-card{display:flex;align-items:center;gap:20rpx}.cat-avatar{width:76rpx;height:76rpx;border-radius:24rpx;background:#fff1dc;display:flex;align-items:center;justify-content:center;font-size:40rpx}.cat-info{flex:1}.cat-info text{display:block;margin-bottom:7rpx}.cat-name{font-weight:800;font-size:31rpx}.tag{display:inline-block!important;color:#527362;background:#edf7ef;border-radius:8rpx;padding:5rpx 10rpx;font-size:20rpx!important;width:max-content}.arrow{font-size:42rpx;color:#afbab2}.primary{background:#eb7356;color:#fff;border-radius:18rpx;margin-top:28rpx;font-size:29rpx;box-shadow:0 10rpx 20rpx #eb735638}.bottom-space{height:80rpx}
