<view class="page"><view class="topbar"><view><text class="eyebrow">HELP CAT · 杭州富阳</text><text class="title">让每一只流浪猫，<text class="accent">有迹可循。</text></text></view><view class="paw">🐾</view></view><view class="search"><text>⌕</text><input placeholder="搜索小区、街道或猫咪" value="{{query}}" bindinput="onSearch" /></view><view class="notice" wx:if="{{taskCount}}" bindtap="openTasks"><text class="notice-icon">✦</text><view><text class="notice-title">有 {{taskCount}} 项任务需要帮助</text><text class="muted">点击查看附近的志愿任务</text></view><text>›</text></view><view class="section-head"><text>附近小区</text><text class="muted">银湖街道 · 全部</text></view><view class="community" wx:for="{{communities}}" wx:key="id"><view><text class="community-name">{{item.name}}</text><text class="muted">{{item.street}}</text></view><text class="count">{{item.cat_count || 0}} 只猫 ›</text></view><view class="section-head"><text>猫咪档案</text><text class="muted">{{cats.length}} 条记录</text></view><view class="cat-card" wx:for="{{cats}}" wx:key="id"><view class="cat-avatar">🐱</view><view class="cat-info"><text class="cat-name">{{item.nickname}}</text><text class="muted">{{item.location_note}}</text><text class="tag">{{item.living_status || '居住情况待补充'}}</text></view><text class="arrow">›</text></view><button class="primary" bindtap="newCat">＋ 新增猫咪档案</button><view class="bottom-space"></view></view>
