HELPCAT_DATABASE_URL=mysql+pymysql://help_cat:change-me@db:3306/help_cat
HELPCAT_STORAGE_ROOT=/app/data/uploads
HELPCAT_ALLOWED_ORIGINS=https://miniapp.example.com,https://admin.example.com
HELPCAT_WECHAT_APP_ID=
HELPCAT_WECHAT_APP_SECRET=
HELPCAT_FAKE_ADMIN_OPENIDS=
HELPCAT_ADMIN_USERNAMES=admin

# 欢迎页「查看管理员联系方式」展示给访客的内容。
# 留空时欢迎页会回退到页面内写死的微信号，因此即使 API 不可用也能联系上。
HELPCAT_ADMIN_WECHAT=
HELPCAT_ADMIN_WECHAT_NOTE=帮帮小猫
HELPCAT_ADMIN_PHONE=
# 二维码图片地址，例如 /assets/site-qr.png；留空则用欢迎页自带的 assets/site-qr.png
HELPCAT_ADMIN_QR_IMAGE=
HELPCAT_ADMIN_CONTACT_NOTE=个人业余发起 · 有空时回复，不承诺随时响应

# 留言防刷：同一 IP 每小时最多提交多少条；同一联系方式多少分钟内视为同一条
HELPCAT_LEAD_RATE_LIMIT_PER_HOUR=10
HELPCAT_LEAD_DEDUPE_MINUTES=10
